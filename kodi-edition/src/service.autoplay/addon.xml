<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.autoplay" name="RÚV Autoplay" version="1.0.0" provider-name="Local">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="autoplay.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary>Autoplay RÚV stream at Kodi startup</summary>
    <description>Starts /storage/ruv_live.strm automatically after Kodi finishes starting.</description>
    <platform>all</platform>
  </extension>
</addon>
